# LLM provider: dashscope or openrouter
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_MODEL=qwen3.7-flash

# OpenRouter API Key for LLM reasoning (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Database
DATABASE_URL=sqlite:///data/supply_chain.db

# UI/backend boundary. Use api for the interview service-mode demo.
UI_BACKEND_MODE=direct
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_TIMEOUT_SECONDS=180
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false

# Optional: Model selection
OPENROUTER_MODEL=openai/gpt-4o-mini

# Offline-published enterprise vector index. Application requests never rebuild it.
RAG_KNOWLEDGE_DIR=data/knowledge
RAG_PERSIST_DIR=data/vector_store
RAG_COLLECTION_NAME=enterprise_knowledge
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_MIN_SCORE=0.25

# P2 autonomous read-only tool guardrails
AGENT_MAX_TOOL_CALLS=6
AGENT_TOOL_TIMEOUT_SECONDS=8

# P3 bounded self-reflection (default 2, hard maximum 3)
AGENT_MAX_REFLECTION_ROUNDS=2

# P4 durable Human-in-the-loop governance
HITL_CHECKPOINT_DB=data/workflow_checkpoints.sqlite
HITL_APPROVAL_TTL_HOURS=24
HITL_DIRECTOR_COST_THRESHOLD=10000
# Bind identities to server-authorized roles; never trust a role submitted by the UI.
HITL_APPROVER_BINDINGS=planner@example.com:supply_chain_manager,manager@example.com:procurement_director,admin@example.com:admin
# Local demo principal resolved on the server; the UI cannot override this identity or role.
HITL_CURRENT_ACTOR_EMAIL=manager@example.com

# Persistent privacy-conscious run/node/model/tool event trace (prompts are not stored).
AGENT_TRACE_PATH=data/agent_traces.jsonl

# Optional LangSmith traces and hosted evaluation experiments.
# Keep the API key only in your local .env. LANGCHAIN_* legacy names also work.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=supply-chain-control-tower
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_EVAL_DATASET=supply-chain-control-tower-regression
LANGSMITH_EXPERIMENT_PREFIX=supply-chain-agent
APP_ENV=local
AGENT_VERSION=interview-v1
AGENT_PROMPT_VERSION=v1
# Set these to true when business inputs/outputs must not leave the machine.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# P5 long-term episodic memory and outcome feedback
AGENT_MAX_LONG_TERM_MEMORIES=5
MEMORY_FEEDBACK_USERS=planner@example.com,analyst@example.com

# P6 deterministic Agent evaluation and regression gate
EVAL_MIN_OVERALL_SCORE=80
EVAL_MAX_BASELINE_DROP=3
